#!/usr/bin/env python3
"""Queue audiobook torrents on the homelab's Transmission instance."""
import shutil
import subprocess
import sys
from urllib.parse import urlsplit

HELP = '''Usage:
  audiobook-download 'magnet:?xt=urn:btih:...'
  audiobook-download 'https://example.com/book.torrent'
  audiobook-download status
  audiobook-download info ID
  audiobook-download pause ID
  audiobook-download resume ID

Quote the whole link, especially if it contains & characters.
Use a magnet link or direct torrent URL, not a website's download page.
Completed files go to node02's audiobook volume; partial files stay hidden.
'''

def main():
    args = sys.argv[1:]
    if not args or args == ['--help'] or args == ['-h']:
        print(HELP)
        return 0 if args else 2
    if args == ['status']:
        remote = ['--list']
    elif len(args) == 2 and args[0] in ('info', 'pause', 'resume'):
        if not args[1].isdigit() or int(args[1]) < 1:
            sys.exit('Use a positive torrent ID from audiobook-download status.')
        action = {'info': '--info', 'pause': '--stop', 'resume': '--start'}[args[0]]
        remote = ['--torrent', args[1], action]
    elif len(args) == 1:
        link = args[0]
        try:
            parsed = urlsplit(link)
        except ValueError:
            sys.exit('Invalid link.')
        if not ((parsed.scheme == 'magnet' and parsed.query) or
                (parsed.scheme in ('https', 'http') and parsed.hostname)):
            sys.exit('Provide a magnet link or a direct HTTP(S) .torrent URL.\n' + HELP)
        remote = ['--download-dir', '/audiobooks', '--add', link]
    else:
        sys.exit(HELP)
    kubectl = shutil.which('kubectl')
    if not kubectl:
        sys.exit('kubectl is required, with access to your homelab cluster.')
    command = [kubectl, '--context', 'kubernetes-admin@kubernetes', '-n',
               'audiobookshelf', 'exec', 'deployment/transmission', '-c', 'transmission', '--',
               '/usr/bin/transmission-remote', '127.0.0.1:9091'] + remote
    try:
        return subprocess.run(command, timeout=120).returncode
    except subprocess.TimeoutExpired:
        sys.exit('Request timed out. Run audiobook-download status before retrying.')
    except KeyboardInterrupt:
        return 130

if __name__ == '__main__':
    sys.exit(main())
